# Chép file này thành `.env` rồi sửa cho máy bạn:
#
#     cp .env.example .env
#
# `.env` đã nằm trong .gitignore. Đừng bao giờ commit nó — đây là chỗ duy nhất
# được giữ token.
#
# Biến môi trường thật thắng file này, nên đặt tạm ở shell là đè được mà không
# phải sửa file:
#
#     CHESSVI_STOCKFISH_BIN=/duong/dan/khac python -m chessvi.serve.web

# -- engine ---------------------------------------------------------------

# Có thể là tên lệnh trên PATH, hoặc đường dẫn tới file.
# Đường dẫn tương đối tính từ thư mục bạn ĐANG CHẠY LỆNH, không phải từ gốc
# repo — hay chạy từ nơi khác thì nên dùng đường dẫn tuyệt đối.
CHESSVI_STOCKFISH_BIN=engines/stockfish/stockfish-windows-x86-64-universal.exe

# Maia chỉ cần cho đối thủ Elo thấp "sai giống người thật". Chưa có cũng không
# sao: web demo lùi về Stockfish yếu (tắt bằng --strict-maia).
#CHESSVI_MAIA_BIN=engines/maia/maia3.exe

# -- thư mục --------------------------------------------------------------

#CHESSVI_DATA_DIR=data
#CHESSVI_MODEL_DIR=models
#CHESSVI_GGUF_PATH=models/chessvi-q4_k_m.gguf

